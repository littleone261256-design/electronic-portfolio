# ------------------------------------------------------------
# Ultimate Personal Expense Logger – AI Enhanced Edition
# Version: 5.0
# Programmer: Mary + AI Assistant
# Date: July 20, 2026
#
# What this program does:
#   Allows the user to add, view, delete, and total expenses.
#   Each expense includes a date, description, category, and amount.
#   Expenses are saved to a text file so they persist between runs.
#
# AI Enhancements:
#   - File integrity checking before loading
#   - Automatic backup creation
#   - Safer input validation
#   - Cleaner menu loop
#   - Internal documentation improvements
#
# Features:
#   - Input validation
#   - Range checking
#   - Error handling
#   - File storage
#   - Monthly totals
#   - Salary percentage calculations
# ------------------------------------------------------------

import os

FILENAME = "ultimate_expenses.txt"
BACKUP_FILE = "ultimate_expenses_backup.txt"

CATEGORIES = ["Food", "Bills", "Gas", "Entertainment", "Other"]


# ------------------------------------------------------------
# Validate date format MM/DD/YYYY
# ------------------------------------------------------------
def validate_date(date_text):
    """Checks if the date is in MM/DD/YYYY format with valid ranges."""
    if len(date_text) != 10:
        return False
    if date_text[2] != "/" or date_text[5] != "/":
        return False

    month = date_text[0:2]
    day = date_text[3:5]
    year = date_text[6:10]

    if not (month.isdigit() and day.isdigit() and year.isdigit()):
        return False

    month = int(month)
    day = int(day)
    year = int(year)

    if month < 1 or month > 12:
        return False
    if day < 1 or day > 31:
        return False
    if year < 1900 or year > 2100:
        return False

    return True


# ------------------------------------------------------------
# Validate positive numeric amount
# ------------------------------------------------------------
def get_positive_number(prompt):
    """Prompts until the user enters a positive numeric value."""
    while True:
        value = input(prompt)

        try:
            value = float(value)
        except ValueError:
            print("Error: Please enter a numeric value.")
            continue

        if value <= 0:
            print("Error: Value must be greater than zero.")
            continue

        return value


# ------------------------------------------------------------
# Create backup file
# ------------------------------------------------------------
def backup_expenses():
    """Creates a backup copy of the expense file."""
    if os.path.exists(FILENAME):
        with open(FILENAME, "r") as original, open(BACKUP_FILE, "w") as backup:
            backup.write(original.read())


# ------------------------------------------------------------
# Load expenses from file with integrity checking
# ------------------------------------------------------------
def load_expenses():
    """Loads expenses from file and checks for corrupted lines."""
    expenses = []

    if not os.path.exists(FILENAME):
        return expenses

    with open(FILENAME, "r") as file:
        for line in file:
            parts = line.strip().split("|")

            # Integrity check: must have exactly 4 parts
            if len(parts) != 4:
                print("Warning: Skipping corrupted line:", line.strip())
                continue

            date, desc, category, amount = parts

            # Validate fields
            if not validate_date(date):
                print("Warning: Invalid date found, skipping:", date)
                continue

            if category not in CATEGORIES:
                print("Warning: Invalid category found, skipping:", category)
                continue

            try:
                float(amount)
            except ValueError:
                print("Warning: Invalid amount found, skipping:", amount)
                continue

            expenses.append(parts)

    return expenses


# ------------------------------------------------------------
# Save expenses to file
# ------------------------------------------------------------
def save_expenses(expenses):
    """Writes all expenses to the main file and updates backup."""
    with open(FILENAME, "w") as file:
        for date, desc, category, amount in expenses:
            file.write(f"{date}|{desc}|{category}|{amount}\n")

    backup_expenses()


# ------------------------------------------------------------
# Add a new expense
# ------------------------------------------------------------
def add_expense(expenses):
    print("\n--- Add New Expense ---")

    while True:
        date = input("Enter date (MM/DD/YYYY): ")
        if validate_date(date):
            break
        print("Error: Invalid date format.")

    description = input("Enter description: ")

    print("\nChoose a category:")
    for i, cat in enumerate(CATEGORIES):
        print(f"{i + 1}. {cat}")

    while True:
        cat_choice = input("Enter category number: ")
        if cat_choice.isdigit() and 1 <= int(cat_choice) <= len(CATEGORIES):
            category = CATEGORIES[int(cat_choice) - 1]
            break
        print("Error: Invalid category.")

    amount = get_positive_number("Enter amount: ")

    expenses.append([date, description, category, str(amount)])
    save_expenses(expenses)

    print("Expense added successfully.\n")


# ------------------------------------------------------------
# View all expenses
# ------------------------------------------------------------
def view_expenses(expenses):
    print("\n--- All Expenses ---")

    if len(expenses) == 0:
        print("No expenses recorded.\n")
        return

    for i, exp in enumerate(expenses):
        print(f"{i + 1}. Date: {exp[0]}, Description: {exp[1]}, Category: {exp[2]}, Amount: ${exp[3]}")

    print()


# ------------------------------------------------------------
# View total spending + salary percentages
# ------------------------------------------------------------
def view_total(expenses):
    total = sum(float(exp[3]) for exp in expenses)
    print(f"\nTotal Spending: ${total:.2f}\n")

    salary = get_positive_number("Enter your salary to calculate percentages: ")

    print("\n--- Expense Percentages ---")
    for exp in expenses:
        amount = float(exp[3])
        percent = (amount / salary) * 100
        print(f"{exp[1]} (${amount:.2f}) [{exp[2]}] = {percent:.2f}% of salary")

    print()


# ------------------------------------------------------------
# View monthly totals
# ------------------------------------------------------------
def view_monthly_totals(expenses):
    print("\n--- Monthly Totals ---")

    if len(expenses) == 0:
        print("No expenses recorded.\n")
        return

    monthly_totals = {m: 0.0 for m in range(1, 13)}

    for exp in expenses:
        month = int(exp[0][0:2])
        monthly_totals[month] += float(exp[3])

    for month, total in monthly_totals.items():
        print(f"Month {month}: ${total:.2f}")

    print()


# ------------------------------------------------------------
# Delete an expense
# ------------------------------------------------------------
def delete_expense(expenses):
    print("\n--- Delete Expense ---")

    if len(expenses) == 0:
        print("No expenses to delete.\n")
        return

    view_expenses(expenses)

    while True:
        choice = input("Enter the number of the expense to delete: ")
        if choice.isdigit() and 1 <= int(choice) <= len(expenses):
            break
        print("Error: Invalid selection.")

    deleted = expenses.pop(int(choice) - 1)
    save_expenses(expenses)

    print(f"Deleted: {deleted[1]} (${deleted[3]})\n")


# ------------------------------------------------------------
# Main menu
# ------------------------------------------------------------
def main():
    expenses = load_expenses()

    while True:
        print("Ultimate Personal Expense Logger – AI Edition")
        print("1. Add a new expense")
        print("2. View all expenses")
        print("3. View total spending + salary percentages")
        print("4. View monthly totals")
        print("5. Delete an expense")
        print("6. Exit")

        choice = input("Choose an option: ")

        if choice == "1":
            add_expense(expenses)
        elif choice == "2":
            view_expenses(expenses)
        elif choice == "3":
            view_total(expenses)
        elif choice == "4":
            view_monthly_totals(expenses)
        elif choice == "5":
            delete_expense(expenses)
        elif choice == "6":
            print("Goodbye!")
            break
        else:
            print("Error: Invalid menu choice.\n")


main()
